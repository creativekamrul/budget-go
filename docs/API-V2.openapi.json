{
  "openapi": "3.1.0",
  "info": {
    "title": "Budget Go Workspace API",
    "version": "2.0.0",
    "description": "Private BDT personal finance. Money uses integer poisha. Same authorization/service as MCP workspace_get/workspace_mutate. Calendar dates and same-owner references are also checked at runtime. Records: maximum 100 accounts, 10,000 transactions/transfers combined, 1,000 budgets, 2 MiB snapshot. Sum of absolute opening/entry/transfer amounts and sum of budgets must each fit the safe integer limit. Accounts referenced by historical entries may be archived; new/edited entries require active accounts. No currency conversion or provider synchronization."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development; configure trusted origin and HTTPS for hosting"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/api/v2/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "summary": "Read the complete authenticated workspace",
        "responses": {
          "200": {
            "description": "Complete current owned workspace. Account balances are derived from opening balances and dated effects; transfers are neutral in consolidated cash flow. Export only: no whole-workspace restore endpoint in this MVP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceData"
                }
              }
            }
          },
          "401": {
            "description": "Safe JSON error with code and message. 409 indicates a revision, idempotency, archive or V1 upgrade conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Safe JSON error with code and message. 409 indicates a revision, idempotency, archive or V1 upgrade conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Safe JSON error with code and message. 409 indicates a revision, idempotency, archive or V1 upgrade conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "mutateWorkspace",
        "summary": "Apply one account, transaction, transfer or budget command",
        "description": "Requires finance:write. Browser-cookie writes require matching Origin; bearer auth never falls back to cookies. Read current revision first. Every new command uses a fresh requestId. After an unknown outcome retry the exact same command/requestId; it returns current state without reapplying. Reusing an ID for another command returns 409. A stale revision with a new requestId returns 409; reload and review before a new write. Deletions require intentional user action.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expectedRevision",
                  "requestId",
                  "command"
                ],
                "properties": {
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "requestId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  },
                  "command": {
                    "$ref": "#/components/schemas/WorkspaceCommand"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete current owned workspace. Account balances are derived from opening balances and dated effects; transfers are neutral in consolidated cash flow. Export only: no whole-workspace restore endpoint in this MVP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceData"
                }
              }
            }
          },
