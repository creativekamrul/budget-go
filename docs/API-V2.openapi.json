  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Manually configured expiring Budget Go integration token; not OAuth. Reads require finance:read, commands finance:write."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "authjs.session-token",
        "description": "Existing Auth.js browser sign-in. Secure hosted cookie uses __Secure-authjs.session-token. Not a client-issued user ID."
      }
    },
    "schemas": {
      "WorkspaceData": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 2
          },
          "currency": {
            "type": "string",
            "const": "BDT"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "accounts": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "bank",
                    "cash",
                    "mobile"
                  ]
                },
                "currency": {
                  "type": "string",
                  "const": "BDT"
                },
                "openingDate": {
                  "type": "string"
                },
                "openingPoisha": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "archived": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "currency",
                "openingDate",
                "openingPoisha",
                "archived"
              ],
              "additionalProperties": false
            }
          },
          "transactions": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "accountId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "category": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "income",
                    "expense"
                  ]
                },
                "poisha": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "accountId",
                "description",
                "category",
                "date",
                "type",
                "poisha"
              ],
              "additionalProperties": false
            }
          },
          "transfers": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "fromAccountId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "toAccountId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "date": {
                  "type": "string"
                },
                "poisha": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "fromAccountId",
                "toAccountId",
                "description",
                "date",
                "poisha"
              ],
              "additionalProperties": false
            }
          },
          "budgets": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "month": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "limitPoisha": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                }
              },
              "required": [
                "month",
                "category",
                "limitPoisha",
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "currency",
          "revision",
          "accounts",
          "transactions",
          "transfers",
          "budgets"
        ],
        "additionalProperties": false
      },
