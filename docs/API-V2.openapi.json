                    ]
                  },
                  "category": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "poisha": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "accountId",
