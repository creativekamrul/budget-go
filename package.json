{
  "name": "budget-go",
  "version": "1.0.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.15.1"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/generate-backup-models.mjs && prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/app-smoke.mjs",
    "test:unit": "node tests/preview-unit.mjs && node tests/workspace-unit.mjs && node tests/classification-unit.mjs && node tests/reports-unit.mjs && node tests/automation-unit.mjs && node tests/docs-contract.mjs && node tests/core-unit.mjs && node tests/finish-finance-unit.mjs && node tests/workbench-unit.mjs",
    "test:core": "node tests/core-acceptance.mjs",
    "test:core:http": "node tests/core-http.mjs",
    "test:core:browser": "node tests/core-browser.mjs",
    "test:automation": "node tests/automation-acceptance.mjs",
    "test:automation:http": "node tests/automation-http.mjs",
    "test:automation:browser": "node tests/automation-browser.mjs",
    "test:classification": "node tests/classification-acceptance.mjs",
    "test:workspace": "node tests/workspace-acceptance.mjs",
    "test:workspace:http": "node tests/workspace-http.mjs",
    "api:generate": "node scripts/generate-backup-models.mjs && tsx scripts/generate-api-v2.ts && tsx scripts/generate-api-v3.ts && tsx scripts/generate-api-automation.ts && tsx scripts/generate-api-planning.ts && tsx scripts/generate-api-v4.ts",
    "db:generate": "node scripts/generate-backup-models.mjs && prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "tsx scripts/db-check.ts",
    "user:create": "tsx scripts/user-admin.ts create",
    "user:reset": "tsx scripts/user-admin.ts reset",
    "user:disable": "tsx scripts/user-admin.ts disable",
    "test:finish-finance": "node tests/finish-finance-acceptance.mjs",
    "test:workbench": "node tests/workbench-acceptance.mjs",
    "test:platform": "node tests/platform-acceptance.mjs",
    "test:finish:browser": "node tests/finish-browser.mjs",
    "test:workbench:http": "node tests/workbench-http.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "test:release": "node tests/release-contract.mjs",
    "test:docker": "node scripts/docker-smoke.mjs",
    "pages:preview": "node scripts/preview-pages.mjs",
    "test:pages": "node tests/pages-contract.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "Kamrul Islam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creativekamrul/budget-go.git"
  },
  "homepage": "https://creativekamrul.github.io/budget-go/",
  "bugs": {
    "url": "https://github.com/creativekamrul/budget-go/issues"
  }
}
