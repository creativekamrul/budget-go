# Copy to .env.docker and fill both blank secrets before running Compose.
# Generate each independently: openssl rand -hex 32
AUTH_SECRET=
POSTGRES_PASSWORD=
# Bundled database credentials use a URL-safe hexadecimal password.
APP_URL=http://127.0.0.1:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
BUDGET_GO_IMAGE=ghcr.io/creativekamrul/budget-go:1.0.0-beta.1
