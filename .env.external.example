# Copy to .env.external; keep private and outside source control.
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=
APP_URL=http://127.0.0.1:3000
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
BUDGET_GO_IMAGE=ghcr.io/creativekamrul/budget-go:1.0.0-beta.1
# Required. Use an empty database dedicated to Budget Go.
# Example shape only: postgresql://user:URL_ENCODED_PASSWORD@database-host:5432/budget_go?schema=public&sslmode=require
# localhost inside the app container is the container itself, not your database host.
DATABASE_URL=
