# Copy to your deployment environment. Never commit real secrets or print database URLs.
# Generate AUTH_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_URL=http://127.0.0.1:3000
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
DATABASE_URL=postgresql://budget_go:replace-password@127.0.0.1:5432/budget_go?schema=public
# Optional, only for independent destructive acceptance in an EMPTY disposable dedicated database:
# TEST_DATABASE_URL=postgresql://budget_go_test:replace-password@127.0.0.1:5432/budget_go_test?schema=public
# Administration passwords are entered via masked interactive prompt, never command-line arguments.
